{
  "kind": "collectionType",
  "collectionName": "fylkesledere",
  "info": {
    "singularName": "fylkesleder",
    "pluralName": "fylkesledere",
    "displayName": "Fylkesleder",
    "description": "Fylkesledere og kontaktinformasjon som vises på kontaktsiden"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "county": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 50
    },
    "fullName": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "title": {
      "type": "string",
      "maxLength": 50
    },
    "contactMail": {
      "type": "email",
      "required": true
    },
    "profileImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "sortOrder": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0
    }
  }
}
